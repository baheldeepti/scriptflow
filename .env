# ============== ScriptFlow .env ==============
# Required: your Gemini API key from https://aistudio.google.com
GOOGLE_API_KEY=P=AIzaSyD6SqRfn0pzI4wVXYvlJWz7-csxJ8Rf5lM
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Which Gemini model to use (don't change unless you know why)
MODEL_NAME=gemini-2.5-flash

# Where the PA Analyzer MCP runs.
# Keep this as localhost while developing.
# Later, after you start ngrok, replace with your ngrok URL + /mcp
PA_ANALYZER_MCP_URL=http://localhost:8080/mcp

# Default SHARP context for LOCAL TESTING only.
# Prompt Opinion auto-injects these when running inside the platform.
DEFAULT_FHIR_BASE_URL=https://hapi.fhir.org/baseR4
DEFAULT_FHIR_TOKEN=
DEFAULT_PATIENT_ID=demo-patient-001

# Public URL of the A2A agent (your ngrok URL later).
# Keep localhost while developing.
A2A_PUBLIC_URL=http://localhost:8000
LOCAL_PORT=8000
