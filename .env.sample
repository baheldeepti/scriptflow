# Copy this file to .env and fill in your values
GOOGLE_API_KEY=your-gemini-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE
MODEL_NAME=gemini-2.5-flash

# Local MCP URL (use ngrok URL when testing with Prompt Opinion)
PA_ANALYZER_MCP_URL=http://localhost:8080/mcp

# FHIR (defaults to public HAPI test server)
DEFAULT_FHIR_BASE_URL=https://hapi.fhir.org/baseR4
DEFAULT_FHIR_TOKEN=
DEFAULT_PATIENT_ID=demo-patient-001

# A2A
A2A_PUBLIC_URL=http://localhost:8000
LOCAL_PORT=8000
